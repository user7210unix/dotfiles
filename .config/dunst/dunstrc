[global]
    ### Geometry & Position
    monitor = 0
    follow = keyboard                  # follows focused window (perfect for i3)
    width = 320
    height = (0, 300)
    origin = top-right
    offset = 12x12
    scale = 0
    notification_limit = 4

    ### Progress bar
    progress_bar = true
    progress_bar_height = 3
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 0

    ### Appearance
    transparency = 8
    separator_height = 0
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 0                    # no full frame
    gap_size = 6
    separator_color = frame
    sort = yes
    idle_threshold = 120

    ### Font (matches your polybar)
    font = Plus Jakarta Sans 10

    ### Markup & Format
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    ### Icons
    icon_position = left
    min_icon_size = 28
    max_icon_size = 48
    icon_path = /usr/share/icons/Papirus-Dark/24x24/status/:/usr/share/icons/Papirus-Dark/24x24/devices/:/usr/share/icons/Papirus-Dark/24x24/apps/

    ### History & Behavior
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 6
    ignore_dbusclose = false

    ### Mouse
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#181818"
    foreground = "#d8d8d8"
    highlight  = "#86c1b9"             # cyan underline
    frame_color = "#86c1b9"
    timeout = 4
    # Bottom underline effect
    default_icon = dialog-information

[urgency_normal]
    background = "#181818"
    foreground = "#d8d8d8"
    highlight  = "#7cafc2"             # blue underline
    frame_color = "#7cafc2"
    timeout = 6
    default_icon = dialog-information

[urgency_critical]
    background = "#181818"
    foreground = "#d8d8d8"
    highlight  = "#ab4642"             # red underline
    frame_color = "#ab4642"
    timeout = 0
    default_icon = dialog-warning

# Optional: make critical notifications more noticeable
[urgency_critical]
    background = "#281818"
    foreground = "#f8f8f8"
