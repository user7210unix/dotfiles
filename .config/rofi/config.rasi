/* ~/.config/rofi/config.rasi
 *
 * Main rofi configuration.
 * Imports pywal's generated dark theme and the custom theme layout.
 * Regenerate colors: wal -R   or   wal -i <wallpaper>
 */

configuration {
    modes:               "drun,run,window";
    font:                "JetBrainsMono Nerd Font 13";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun:        " Apps";
    display-run:         " Run";
    display-window:      " Win";
    matching:            "fuzzy";
    scroll-method:       0;
    disable-history:     false;
    terminal:            "kitty";
}

/* ── Import pywal colors (generated by `wal`) ─────────────────────────────── */
@import "~/.cache/wal/colors-rofi-dark.rasi"


