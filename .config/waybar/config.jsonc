{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 2,
    "fixed-center": true,

    // sections
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["custom/weather"],
    "modules-right": [
        "pulseaudio",
        "cpu",
        "memory",
        "disk",
        "network",
        "battery",
        "clock"
    ],

    // sway workspaces
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "format-icons": {
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },

    // sway/mode
    "sway/mode": {
        "format": " {}"
    },

    // weather
    // needs: curl, jq
    "custom/weather": {
        "exec": "~/.config/waybar/weather.sh",
        "return-type": "json",
        "interval": 900,
        "tooltip": true
    },

    // pulseaudio
    "pulseaudio": {
        "format":        "{icon} {volume}%",
        "format-muted":  "  mute",
        "format-icons": {
            "headphone":  "",
            "hands-free": "",
            "headset":    "",
            "phone":      "",
            "portable":   "",
            "car":        "",
            "default":    ["", "", ""]
        },
        "on-click":       "pavucontrol",
        "on-scroll-up":   "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "tooltip-format": "{desc}"
    },

    
    // cpu
    "cpu": {
        "interval": 5,
        "format":   " {usage}%",
        "tooltip":  true,
        "tooltip-format": "CPU  {usage}%\nLoad {load}"
    },

    // memory
    "memory": {
        "interval": 10,
        "format":   " {used:.1f}G",
        "tooltip":  true,
        "tooltip-format": "RAM  {used:.1f} / {total:.1f} GiB\nSwap {swapUsed:.1f} / {swapTotal:.1f} GiB"
    },

    // disk
    "disk": {
        "path":     "/home",
        "interval": 30,
        "format":   " {free}",
        "tooltip":  true,
        "tooltip-format": "/home  {used} used of {total}\n({percentage_used}% full)"
    },

    //  network (wifi + signal strength) 
    "network": {
        "interval":               30,
        "format-wifi":            "{icon} {essid} {signalStrength}%",
        "format-ethernet":        " {ipaddr}",
        "format-disconnected":    " disconnected",
        "format-linked":          " (no IP)",
        "format-icons":           ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi":    "{essid}\n{signalStrength}%  {signaldBm} dBm\n{frequency} GHz\n{ifname} · {ipaddr}",
        "tooltip-format-ethernet":"󰊗 {ifname} · {ipaddr}",
        "tooltip-format-disconnected": "No network",
        "max-length": 30,
        "on-click":   "foot -e nmtui"
    },

    // battery 
    "battery": {
        "states": {
            "good":     95,
            "warning":  30,
            "critical": 15
        },
        "format":           "{icon} {capacity}%",
        "format-charging":  " {capacity}%",
        "format-plugged":   " {capacity}%",
        "format-full":      " full",
        "format-icons":     ["", "", "", "", ""],
        "tooltip-format":   "{timeTo}\n{power:.1f} W"
    },

    // clock
    "clock": {
        "interval": 60,
        "format":          " {:%H:%M  %d/%m/%y}",
        "tooltip-format":  "<big>{:%A, %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    }
}
